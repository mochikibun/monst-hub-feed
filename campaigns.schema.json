{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MONST HUB campaign feed v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "timezone", "date_precision", "campaigns"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "timezone": {"const": "Asia/Tokyo"},
    "date_precision": {"const": "day"},
    "campaigns": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "category", "name", "start_date", "end_date", "daily_attributes", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
          "category": {"enum": ["archive", "temple", "normal", "descent", "other"]},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "start_date": {"type": "string", "format": "date"},
          "end_date": {"type": "string", "format": "date"},
          "daily_attributes": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["date", "attribute"],
              "properties": {"date": {"type": "string", "format": "date"}, "attribute": {"enum": ["火", "水", "木", "光", "闇"]}}
            }
          },
          "source": {
            "type": "object", "additionalProperties": false, "required": ["name", "url", "official"],
            "properties": {
              "name": {"enum": ["公式", "GameWith", "Game8", "AppMedia", "アルテマ"]},
              "url": {"type": "string", "format": "uri", "pattern": "^https://"},
              "official": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
